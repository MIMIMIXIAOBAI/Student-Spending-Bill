<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 浅黄 → 白 渐变基底 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="@color/bg_card"
                android:startColor="@color/glass_yellow" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>

    <!-- 气泡 -->
    <item
        android:width="130dp"
        android:height="130dp"
        android:bottom="0dp"
        android:gravity="top|end"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="@color/glass_bubble" />
        </shape>
    </item>

    <item
        android:width="72dp"
        android:height="72dp"
        android:bottom="10dp"
        android:gravity="bottom|start"
        android:left="16dp">
        <shape android:shape="oval">
            <solid android:color="@color/glass_bubble" />
        </shape>
    </item>

</layer-list>
