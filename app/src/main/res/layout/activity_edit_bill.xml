<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_gradient"
    android:orientation="vertical">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_sm"
        android:paddingTop="@dimen/space_xl"
        android:paddingEnd="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/chat_back"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/chat_back"
            android:textColor="@color/text_primary"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/edit_bill_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_card_title"
            android:textStyle="bold" />

        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/page_padding"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/page_padding"
            android:paddingBottom="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_bill_type_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_input"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tvTypeExpense"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/bill_type_expense"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:id="@+id/tvTypeIncome"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/bill_type_income"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_padding"
                    android:text="@string/edit_bill_amount_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <EditText
                    android:id="@+id/etAmount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_input"
                    android:hint="@string/edit_bill_amount_hint"
                    android:inputType="numberDecimal"
                    android:maxLength="10"
                    android:paddingStart="@dimen/space_md"
                    android:paddingEnd="@dimen/space_md"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_padding"
                    android:text="@string/edit_bill_category_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_input">

                    <Spinner
                        android:id="@+id/spinnerCategory"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:paddingStart="@dimen/space_md"
                        android:paddingEnd="@dimen/space_sm"
                        android:spinnerMode="dropdown" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_padding"
                    android:text="@string/edit_bill_merchant_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <EditText
                    android:id="@+id/etMerchant"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_input"
                    android:hint="@string/edit_bill_optional_hint"
                    android:inputType="text"
                    android:maxLength="40"
                    android:paddingStart="@dimen/space_md"
                    android:paddingEnd="@dimen/space_md"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_padding"
                    android:text="@string/edit_bill_remark_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <EditText
                    android:id="@+id/etRemark"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_input"
                    android:hint="@string/edit_bill_optional_hint"
                    android:inputType="text"
                    android:maxLength="60"
                    android:paddingStart="@dimen/space_md"
                    android:paddingEnd="@dimen/space_md"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_padding"
                    android:text="@string/edit_bill_datetime_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/space_md"
                        android:paddingEnd="@dimen/space_md"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:id="@+id/tvTime"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/space_md"
                        android:paddingEnd="@dimen/space_md"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <TextView
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="@dimen/page_padding"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/page_padding"
        android:background="@drawable/bg_button_primary"
        android:clickable="true"
        android:elevation="2dp"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/btn_save"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_card_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPrivacyTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="@dimen/card_padding"
        android:text="@string/edit_privacy_tip"
        android:textColor="@color/text_hint"
        android:textSize="11sp" />

</LinearLayout>
